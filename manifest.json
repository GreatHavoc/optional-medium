{
  "manifest_version": 3,
  "name": "Optional Medium",
  "version": "2.0.0",
  "description": "Makes the Medium site optional: opens Medium links (medium.com and custom-domain publications) on a Freedium mirror instead of loading Medium directly.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "alarms"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "optional-medium@greathavoc.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "host_permissions": [
    "*://medium.com/*",
    "*://*.medium.com/*",
    "*://blog.vijayasekhardeepak.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Medium to Freedium",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
